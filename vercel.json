{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=()" }
    ] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/watch-tower/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "redirects": [
    { "source": "/tenant/:slug/command-center/", "destination": "/command-center/?tenant=:slug", "permanent": false },
    { "source": "/tenant/:slug/hybrid/", "destination": "/hybrid/?tenant=:slug", "permanent": false },
    { "source": "/tenant/:slug/", "destination": "/?tenant=:slug", "permanent": false },
    { "source": "/:slug/command-center/", "destination": "/command-center/?tenant=:slug", "permanent": false },
    { "source": "/:slug/hybrid/", "destination": "/hybrid/?tenant=:slug", "permanent": false }
  ]
}
